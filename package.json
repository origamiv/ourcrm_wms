{
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite --host 0.0.0.0 --port 5173",
        "typecheck": "vue-tsc --noEmit",
        "test:cache": "tsx --test tests/frontend/*.test.ts",
        "test:browser": "playwright test",
        "cloud:setup": "cp .env.cloud .env && php artisan key:generate --force && php artisan migrate --force && npm run build",
        "cloud:dev": "concurrently \"php artisan serve --host=0.0.0.0 --port=8000\" \"npm run dev\"",
        "cloud:build": "npm run build && php artisan optimize:clear"
    },
    "devDependencies": {
        "@playwright/test": "^1.63.0",
        "@tailwindcss/vite": "^4.1.10",
        "@vitejs/plugin-vue": "^5.2.4",
        "axios": "^1.7.4",
        "concurrently": "^9.0.1",
        "daisyui": "^5.0.43",
        "fake-indexeddb": "^6.2.5",
        "laravel-vite-plugin": "^1.2.0",
        "prettier": "^3.9.6",
        "tailwindcss": "^4.1.10",
        "tsx": "^4.23.13",
        "typescript": "~5.9.3",
        "vite": "^6.0.11",
        "vue-tsc": "^3.3.11"
    },
    "dependencies": {
        "@fontsource/manrope": "^5.3.0",
        "@inertiajs/vue3": "^2.3.27",
        "@svar-ui/core-locales": "^2.6.1",
        "@svar-ui/vue-core": "^2.6.1",
        "@svar-ui/vue-filter": "^2.6.1",
        "dompurify": "^3.4.15",
        "flatpickr": "^4.6.13",
        "marked": "^18.0.13",
        "vue": "^3.5.42",
        "vuetify": "^3.13.4",
        "xlsx": "^0.18.5"
    }
}
