APP_NAME="WMS Cloud Development"
APP_ENV=development
APP_KEY=base64:N2h+YANwav0ORt/5EGInAr2dEp6fvIO+MLwkKNig+iw=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_TIMEZONE=Europe/Moscow
APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ru_RU

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# SQLite для простоты в облаке
DB_CONNECTION=sqlite
DB_DATABASE=/workspace/database/database.sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
CACHE_PREFIX=wms_cloud_cache_

MAIL_MAILER=log
MAIL_FROM_ADDRESS="wms@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Отключаем внешние сервисы
AITUNNEL_TOKEN=
CAILA_TOKEN=